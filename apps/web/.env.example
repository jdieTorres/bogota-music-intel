NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Para leer afiches en /admin. Se saca en console.anthropic.com → API keys.
#
# ⚠️ Sin el prefijo NEXT_PUBLIC_ a propósito: una clave con ese prefijo va al
# bundle del navegador, o sea al alcance de cualquiera que abra el sitio. Esta
# se lee solo del lado del servidor, en app/api/afiche/route.ts.
#
# Es la única dependencia paga del proyecto. Leer un afiche cuesta ~US$0,01.
ANTHROPIC_API_KEY=
